<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spec 001 — Constitution 원칙 V (민감정보 로그 마스킹).

  MaskingPatternConverter를 'msk' 변환 워드로 등록하고, CONSOLE 로그 패턴에서
  %m(원본 메시지) 대신 %msk(마스킹된 메시지)를 사용한다. Spring Boot의 기본
  console-appender.xml은 ${CONSOLE_LOG_PATTERN}을 참조하므로, 본 파일이
  먼저 로드되면서 패턴을 override한다.
-->
<configuration>

    <conversionRule conversionWord="msk"
                    converterClass="com.planetrush.planetrush.core.logging.MaskingPatternConverter"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %msk%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
